{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Habilidad",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "nombre",
      "categoria",
      "activa"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^H\\d{3}$"
      },
      "nombre": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "categoria": {
        "enum": [
          "Lenguaje",
          "Framework",
          "Datos",
          "Nube",
          "Herramienta",
          "Frontend"
        ]
      },
      "descripcion": {
        "type": "string",
        "maxLength": 200
      },
      "activa": {
        "type": "boolean"
      }
    }
  }
}